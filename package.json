{
  "name": "anti-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron wrapper for agentic shell tasks with dynamic task-specific UI.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.node.json -w\" \"vite\" \"wait-on dist-electron/main/main.js http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.88",
    "ai": "^6.0.319",
    "electron": "^42.11.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "packageManager": "pnpm@10.34.9"
}
